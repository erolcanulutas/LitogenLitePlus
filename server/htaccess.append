
# ---------------------------------------------------------------------------
# Litogen
# ---------------------------------------------------------------------------

# Everything over HTTPS. The session cookie is marked Secure, so on plain HTTP
# it would never be sent and nobody could stay signed in.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# One page, many addresses: anything that is not a real file is the app, which
# reads the address itself. The API is left alone.
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Only the files under /assets/ carry a hash of their contents in their name,
# so only those can never mean anything else and may be kept for as long as the
# browser likes. Everything else keeps its name from one build to the next —
# favicon.ico above all — and a year of immutable on one of those is a year of
# not being able to change it.
# The long cache lives in assets/.htaccess rather than here: a rule that has to
# recognise the folder from the request path depends on the server setting an
# environment variable for it, and this one does not. A file in the folder
# needs no such agreement.
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|png|jpe?g|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Nothing here is a directory anyone should be able to read.
Options -Indexes
